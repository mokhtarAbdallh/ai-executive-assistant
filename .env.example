# Dawwen Local Development Environment Configuration
NODE_ENV=development
AWS_REGION=eu-central-1

# LocalStack endpoint (for local S3 and SQS emulation; leave empty in production)
AWS_ENDPOINT_URL=http://localhost:4566

# Database (Postgres with pgvector)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=meetings
DB_USER=dawwen
DB_PASSWORD=dawwen_dev_pw

# Storage and Queue
AUDIO_BUCKET=meeting-assistant-audio
AUDIO_QUEUE_URL=http://localhost:4566/000000000000/meeting-assistant-audio-processing

# Secrets
APP_SECRET=dawwen-dev-secret-must-be-at-least-32-chars-long
ASR_API_KEY=
GOOGLE_OAUTH=

# Provider Selection (use 'fake' for offline zero-cost demo)
AUTH_PROVIDER=local
ASR_PROVIDER=fake
LLM_PROVIDER=fake
DEMO_MODE=true

# Bedrock (used only if LLM_PROVIDER=bedrock)
BEDROCK_MODEL_ID=
BEDROCK_EMBEDDING_MODEL_ID=
EMBEDDING_DIM=1024

# Base URL and CORS
PUBLIC_BASE_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# Pricing Rules (USD micros: 1 USD = 1,000,000 micros)
PRICING_CONFIG={"customerPricePerAudioMinuteMicros":20000,"providerCosts":{"asrPerAudioMinuteMicros":{"fake":0,"elevenlabs":3667},"llmPerMillionInputTokensMicros":{"fake":0,"bedrock":3000},"llmPerMillionOutputTokensMicros":{"fake":0,"bedrock":15000},"embeddingsPerMillionTokensMicros":{"fake":0,"bedrock":100}},"lowBalanceThresholdMicros":1000000}
