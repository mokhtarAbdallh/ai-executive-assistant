{
  "name": "@dawwen/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --conditions=source src/main.ts",
    "build": "tsup",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.740.0",
    "@aws-sdk/client-s3": "^3.740.0",
    "@aws-sdk/client-sqs": "^3.740.0",
    "@dawwen/asr": "workspace:*",
    "@dawwen/config": "workspace:*",
    "@dawwen/db": "workspace:*",
    "@dawwen/llm": "workspace:*",
    "@dawwen/shared": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.3.6",
    "tsx": "^4.19.2",
    "vitest": "^3.0.5"
  }
}
