# Learner Lab settings (ADR-026). setup.sh writes deploy/lab/.env.lab from this file.
# .env.lab holds secrets: it is git-ignored and must never be committed (the repo is public).

NODE_ENV=production
AWS_REGION=us-east-1

# Site address: <public-ip-with-dashes>.sslip.io (free HTTPS) or :80 (HTTP only)
SITE_ADDRESS=
PUBLIC_BASE_URL=
CORS_ORIGINS=
# Only "false" when SITE_ADDRESS=:80 (browsers drop Secure cookies over plain HTTP)
COOKIE_SECURE=true

# Postgres runs on the same server (container "postgres"), so no TLS
DB_HOST=postgres
DB_PORT=5432
DB_NAME=dawwen
DB_USER=dawwen
DB_PASSWORD=
DB_SSL=false

# Real S3 + SQS in the Lab account (created by aws-resources.sh; credentials come from LabRole)
AUDIO_BUCKET=
AUDIO_QUEUE_URL=

APP_SECRET=
AUTH_PROVIDER=local
DEMO_MODE=false

# Speech to text: Whisper on Groq (free tier)
ASR_PROVIDER=openai-whisper
ASR_HTTP_URL=https://api.groq.com/openai/v1
ASR_HTTP_API_KEY=
ASR_MODEL=whisper-large-v3
# 2-minute chunks keep the request count low for the free tier's per-minute limit
ASR_HTTP_OPTIONS={"chunkSeconds":120,"overlapSeconds":2,"concurrency":2}

# Meeting analysis + search embeddings: Gemini (free tier, OpenAI-compatible endpoint)
LLM_PROVIDER=openai-compatible
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_KEY=
LLM_MODEL=gemini-2.5-flash
LLM_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=1024

# Free providers cost 0; customers are still charged the per-minute price from their credit
PRICING_CONFIG={"customerPricePerAudioMinuteMicros":30000,"providerCosts":{"asrPerAudioMinuteMicros":{"openai-whisper":0},"llmPerMillionInputTokensMicros":{"openai-compatible":0},"llmPerMillionOutputTokensMicros":{"openai-compatible":0},"embeddingsPerMillionTokensMicros":{"openai-compatible":0}},"lowBalanceThresholdMicros":1000000}
