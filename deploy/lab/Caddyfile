# SITE_ADDRESS = "<a-b-c-d>.sslip.io" → automatic Let's Encrypt HTTPS (free).
# SITE_ADDRESS = ":80"                 → plain HTTP (then set COOKIE_SECURE=false in .env.lab).
{$SITE_ADDRESS} {
	encode gzip

	# Invariant 6: the API only answers under /api.
	handle /api/* {
		reverse_proxy api:8080
	}

	handle {
		reverse_proxy web:3000
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}
